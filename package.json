{
  "name": "@airbuild/react-native",
  "version": "0.2.0",
  "description": "AirBuild Distribution SDK for React Native. Check for new binary builds from AirBuild install links and prompt testers to install them, plus CodePush telemetry for OTA updates.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "keywords": [
    "airbuild",
    "react-native",
    "distribution",
    "ota",
    "codepush",
    "code-push",
    "expo-updates",
    "beta",
    "app-distribution",
    "apk",
    "ipa",
    "install"
  ],
  "homepage": "https://airbuild.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/airbuild/airbuild-react-native.git"
  },
  "issue_tracker": "https://github.com/airbuild/airbuild-react-native/issues",
  "license": "MIT",
  "scripts": {
    "prepare": "bob build",
    "build": "bob build",
    "clean": "del lib",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "expo-updates": ">=0.25.0"
  },
  "peerDependenciesMeta": {
    "expo-updates": {
      "optional": true
    }
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.3.0",
    "@types/react": "^18.2.0",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
